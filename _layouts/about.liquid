---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    {% if page.profile.image %}
      <script>
        // Size the profile photo so its height matches the intro text beside it.
        // Width follows from the photo's own aspect ratio, so it is never distorted.
        (function () {
          var profile = document.querySelector('article > .profile');
          var img = profile && profile.querySelector('img');
          var intro = profile && profile.parentElement.querySelector(':scope > .clearfix');
          if (!img || !intro) return;

          function textHeight() {
            var blocks = intro.children;
            if (!blocks.length) return 0;
            return blocks[blocks.length - 1].getBoundingClientRect().bottom - blocks[0].getBoundingClientRect().top;
          }

          function fit() {
            if (window.innerWidth < 576 || !img.naturalWidth) {
              profile.style.width = '';
              return;
            }
            var ratio = img.naturalHeight / img.naturalWidth;
            var container = profile.parentElement.clientWidth;
            var minW = container * 0.2;
            var maxW = container * 0.4;
            var w = profile.getBoundingClientRect().width;
            // The text reflows as the photo changes width, so settle over a few passes.
            for (var i = 0; i < 8; i++) {
              var target = Math.max(minW, Math.min(maxW, textHeight() / ratio));
              if (Math.abs(target - w) < 1) break;
              w = (w + target) / 2;
              profile.style.width = w + 'px';
            }
          }

          if (img.complete) fit();
          img.addEventListener('load', fit);
          window.addEventListener('load', fit);
          window.addEventListener('resize', fit);
          if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
          // Re-fit whenever the intro reflows (for example when a web font finishes loading).
          if (window.ResizeObserver) {
            var pending = false;
            new ResizeObserver(function () {
              if (pending) return;
              pending = true;
              requestAnimationFrame(function () {
                pending = false;
                fit();
              });
            }).observe(intro);
          }
        })();
      </script>
    {% endif %}

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>
